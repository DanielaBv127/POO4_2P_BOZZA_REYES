<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/balsamiq_sans_bold"
            android:text="Ver Comunicados"
            android:textColor="#CE156F"
            android:textSize="29sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFechas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="564dp">

            <LinearLayout
                android:id="@+id/layoutComunicados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E63692"
            android:fontFamily="@font/balsamiq_sans_bold"
            android:text="Volver"
            android:textColor="#FFFFFF"
            android:textColorHighlight="#E63692"
            android:textColorHint="#E63692"
            android:textColorLink="#E63692" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
