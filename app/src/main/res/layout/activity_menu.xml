<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="43dp"
        android:layout_marginTop="131dp"
        android:layout_marginEnd="43dp"
        android:layout_marginBottom="131dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Space
            android:layout_width="match_parent"
            android:layout_height="173dp" />

        <Button
            android:id="@+id/btnVerComunicados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E63692"
            android:fontFamily="@font/balsamiq_sans_bold"
            android:text="Ver Comunicados" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="33dp" />

        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E63692"
            android:fontFamily="@font/balsamiq_sans_bold"
            android:text="Publicar Comunicados" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="33dp" />

        <Button
            android:id="@+id/btnTablero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#E63692"
            android:fontFamily="@font/balsamiq_sans_bold"
            android:text="Tablero Comunicados" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>