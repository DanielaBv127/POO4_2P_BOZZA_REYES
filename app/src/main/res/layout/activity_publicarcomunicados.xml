<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/balsamiq_sans_bold"
            android:text="Nuevo Comunicado"
            android:textColor="#971952"
            android:textColorLink="#C49818"
            android:textSize="29sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView10"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:fontFamily="@font/balsamiq_sans_bold"
                android:text="Tipo:"
                android:textColor="#140A0A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="237dp"
                android:layout_height="37dp"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/rgTipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbAnuncio"
                        android:layout_width="120dp"
                        android:layout_height="35dp"
                        android:fontFamily="@font/balsamiq_sans"
                        android:text="Anuncio" />

                    <RadioButton
                        android:id="@+id/rbEvento"
                        android:layout_width="117dp"
                        android:layout_height="35dp"
                        android:fontFamily="@font/balsamiq_sans"
                        android:text="Evento" />

                </RadioGroup>
            </LinearLayout>
        </LinearLayout>


        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="29dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView11"
                android:layout_width="89dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/balsamiq_sans_bold"
                android:text="Área:"
                android:textColor="#140A0A"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/spArea"
                    android:fontFamily="@font/balsamiq_sans"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:entries="@array/spinner_opciones_array" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView12"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/balsamiq_sans_bold"
                android:text="Audiencia:"
                android:textColor="#140A0A"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="109dp"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/checkbox_estudiantes"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:fontFamily="@font/balsamiq_sans"
                    android:text="Estudiantes" />

                <CheckBox
                    android:id="@+id/checkbox_profesores"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:fontFamily="@font/balsamiq_sans"
                    android:text="Profesores" />

                <CheckBox
                    android:id="@+id/checkbox_administrativo"
                    android:layout_width="match_parent"
                    android:layout_height="37dp"
                    android:fontFamily="@font/balsamiq_sans"
                    android:text="Administrativo" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEvento"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lugar del Evento:"
                android:textSize="16sp"
                android:fontFamily="@font/balsamiq_sans"
                android:layout_marginTop="8dp"/>

            <EditText
                android:id="@+id/etLugarEvento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/balsamiq_sans"
            android:hint="Ingresa el lugar"
            android:inputType="text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha del Evento:"
                android:fontFamily="@font/balsamiq_sans"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <DatePicker
                android:id="@+id/datePickerEvento"
                android:fontFamily="@font/balsamiq_sans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:calendarViewShown="false" /> <!-- Oculta la vista de calendario completa si prefieres un selector compacto -->
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAnuncio"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel de Urgencia:"
                android:textSize="16sp"
                android:layout_marginTop="8dp"/>

            <Spinner
                android:id="@+id/spUrgencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/spinner_urgencia_array" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TextV_titulo"
                android:layout_width="98dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/balsamiq_sans_bold"
                android:text="Título:"
                android:textColor="#140A0A"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edit_text_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:fontFamily="@font/balsamiq_sans_bold"
                    android:inputType="text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TextV_descripcion"
                android:layout_width="98dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/balsamiq_sans_bold"
                android:text="Descripción:"
                android:textColor="#140A0A"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/edit_text_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ems="10"
                    android:fontFamily="@font/balsamiq_sans_bold"
                    android:inputType="text"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TextViewArte"
                android:layout_width="101dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/balsamiq_sans_bold"
                android:text="Arte:"
                android:textColor="#140A0A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeleccionarImagen"
                android:layout_width="237dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#E63692"
                android:fontFamily="@font/balsamiq_sans"
                android:text="Adjuntar Imagen"
                android:textSize="15dp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPublicar"
                android:layout_width="165dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#E63692"
                android:fontFamily="@font/balsamiq_sans"
                android:text="Publicar"
                android:textSize="15dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <Button
                android:id="@+id/btnVolver"
                android:layout_width="165dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#E63692"
                android:fontFamily="@font/balsamiq_sans"
                android:text="Volver"
                android:textSize="15dp"
                app:rippleColor="#6430F2" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
